{
  "name": "open-prompt-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter=@open-prompt-os/api --filter @open-prompt-os/web dev < /dev/null 2>&1 | tee api.log",
    "db:generate": "pnpm --filter @open-prompt-os/db db:generate",
    "db:migrate": "pnpm --filter @open-prompt-os/db db:migrate && pnpm --filter @open-prompt-os/db db:rls",
    "db:migrate:deploy": "pnpm --filter @open-prompt-os/db db:migrate:deploy && pnpm --filter @open-prompt-os/db db:rls",
    "db:rls": "pnpm --filter @open-prompt-os/db db:rls",
    "db:seed": "pnpm --filter @open-prompt-os/db db:seed",
    "build": "turbo run build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @open-prompt-os/web test:e2e",
    "test:e2e:smoke": "pnpm --filter @open-prompt-os/web test:e2e:smoke",
    "test:e2e:ui": "pnpm --filter @open-prompt-os/web test:e2e:ui",
    "verify:e2e-integrity": "node scripts/check-e2e-integrity.mjs",
    "verify": "pnpm verify:e2e-integrity && pnpm typecheck && pnpm test && pnpm test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "3.2.7",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
