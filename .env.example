GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
NODE_ENV=development
PORT=3001
WEB_ORIGINS=http://localhost:5173
LLM_TIMEOUT_MS=30000
RATE_LIMIT_PER_MINUTE=30
GLOBAL_GUEST_DAILY_LIMIT=500
# Proxy IP trust mode: false (direct) | proxy (rightmost X-Forwarded-For, ignores cf-connecting-ip) | cloudflare (only cf-connecting-ip)
TRUST_PROXY=false
VITE_API_URL=same-origin
API_PROXY_TARGET=http://127.0.0.1:3001

# ── Database (PostgreSQL) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=*******
POSTGRES_DB=open_prompt_os

# ── Auth (Better Auth) ──
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Optional key rotation: comma-separated <version>:<secret>, current first.
# Older entries only decrypt/verify existing data. When set, BETTER_AUTH_SECRET is
# only a fallback for data written before rotation. See README "Rotating the auth secret".
BETTER_AUTH_SECRETS=2:<new-secret>,1:<previous-secret>
BETTER_AUTH_URL=http://localhost:3001
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:5173

# ── Email (Resend in production, console in local dev) ──
MAIL_PROVIDER=console
MAIL_FROM="OpenPrompt OS <login@mail.openpromptos.com>"
MAIL_REPLY_TO=hello@openpromptos.com
RESEND_API_KEY=

# ── Social OAuth (optional; hidden in UI when unset) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── CAPTCHA (Cloudflare Turnstile, optional) ──
# Leave empty to disable Turnstile verification locally.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ── Billing (Stripe, optional; falls back to LocalBillingEmulator when unset) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# ── Analytics (PostHog, optional) ──
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
