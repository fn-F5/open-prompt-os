GEMINI_API_KEY=
GEMINI_API_KEY_2=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
NODE_ENV=development
PORT=3001
WEB_ORIGINS=http://localhost:5173
LLM_TIMEOUT_MS=90000
RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=false
VITE_API_URL=same-origin
API_PROXY_TARGET=http://127.0.0.1:3001

# ── Database (PostgreSQL) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=*******
POSTGRES_DB=open_prompt_os
# Optional: full connection string override (e.g. hosted Postgres). When unset,
# packages/db composes it from the POSTGRES_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# ── Auth (Better Auth) ──
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:5173

# ── Email (Resend in production, console in local dev) ──
MAIL_PROVIDER=console
MAIL_FROM="OpenPrompt OS <login@mail.openpromptos.com>"
MAIL_REPLY_TO=hello@openpromptos.com
RESEND_API_KEY=

# ── Social OAuth (optional; hidden in UI when unset) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── CAPTCHA (Cloudflare Turnstile, optional) ──
# Leave empty to disable Turnstile verification locally.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
